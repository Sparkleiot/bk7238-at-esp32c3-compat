+/* ESP-AT 兼容修复(#10): AT+CIPSTART="UDP",<host>,<port>[,<local port>[,<mode>]] 的
+ * local port 必须绑定到本地 socket, 否则对端按 ESP-AT 文档向该端口回发时
+ * 包全部落空(socket 被 lwIP 绑在随机端口)。local_port=0 时保持原行为。 */
+uintptr_t HAL_UDP_ConnectBind(const char *host, unsigned int port, unsigned short local_port)
+{
+    struct sockaddr_in local_addr;
+    int fd;
+    struct addrinfo hints, *addr_list, *cur;
+    uintptr_t ret = 0;
+    char port_str[6] = {0};
+
+    snprintf(port_str, 6, "%d", port);
+    memset((char *)&hints, 0x00, sizeof(hints));
+    hints.ai_socktype = SOCK_DGRAM;
+    hints.ai_family   = AF_INET;
+    hints.ai_protocol = IPPROTO_UDP;
+
+    if (getaddrinfo(host, port_str, &hints, &addr_list) != 0) {
+        return 0;
+    }
+
+    for (cur = addr_list; cur != NULL; cur = cur->ai_next) {
+        fd = socket(cur->ai_family, cur->ai_socktype, cur->ai_protocol);
+        if (fd < 0) {
+            ret = 0;
+            continue;
+        }
+
+        if (local_port) {
+            memset(&local_addr, 0, sizeof(local_addr));
+            local_addr.sin_family      = AF_INET;
+            local_addr.sin_port        = htons(local_port);
+            local_addr.sin_addr.s_addr = htonl(INADDR_ANY);
+            if (bind(fd, (struct sockaddr *)&local_addr, sizeof(local_addr)) != 0) {
+                ATSVRLOG("udp bind local:%d fail,errno:%d", local_port, errno);
+                close(fd);
+                ret = 0;
+                continue;
+            }
+        }
+
+        if (0 == connect(fd, cur->ai_addr, cur->ai_addrlen)) {
+            ret = fd + LWIP_SOCKET_FD_SHIFT;
+            break;
+        }
+
+        close(fd);
+        ret = 0;
+    }
+
+    if (0 == ret) {
+        ATSVRLOG("fail to establish udp(bind lport=%d)", local_port);
+    } else {
+        ATSVRLOG("success to establish udp lport=%d, fd=%d", local_port, ret);
+    }
+
+    freeaddrinfo(addr_list);
+    return ret;
+}

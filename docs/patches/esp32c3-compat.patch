--- a/application.mk
+++ b/application.mk
@@ -309,6 +309,24 @@
 # Beken SDK include folder and source file list
 -include ./beken378/beken_src.mk
 
+# ---------------------------------------------------------------------------
+# [ESP32-C3 兼容工程 · 宿主机适配] include 列表落盘, 规避 shell 命令行长度上限
+#
+# 本机 make 的 SHELL 是 PortableGit 的 sh, 它把 recipe 交给子进程时命令行
+# 上限约 8KB; 而上面 beken_src.mk 累积出的 INCLUDES 展开后有 11~18KB, 会被
+# 从中间硬截断 —— gcc 于是既收不到源文件名也收不到 -c, 报出极具误导性的:
+#     arm-none-eabi-gcc.exe: error: -E or -x required when input is from standard input
+#     arm-none-eabi-gcc.exe: fatal error: no input files
+# 这与源码、与头文件路径都无关, 纯粹是命令行被截断。
+#
+# 把 include 列表写成 GCC 响应文件, recipe 里只出现 @<文件>, 长度问题彻底消失。
+# (链接命令约 3KB、ar 约 3KB, 均在上限内, 无需处理。)
+# ---------------------------------------------------------------------------
+INCLUDES_FILE := $(OBJ_DIR)/esp_at_includes.rsp
+INCLUDES_RSP := @$(INCLUDES_FILE)
+$(shell mkdir -p $(OBJ_DIR) 2>/dev/null)
+$(file >$(INCLUDES_FILE),$(INCLUDES))
+
 # Generate obj list
 # -------------------------------------------------------------------
 OBJ_LIST = $(SRC_C:%.c=$(OBJ_DIR)/%.o)
